/*
 * Boardsource Wireless Lily58 SMT ("BLE Lulu": built-in nRF52840).
 *
 * Shared layout: the wired Lulu runs the same layers from
 * keyboards/boardsource/lulu/keymaps/andy/keymap.c (QMK). Change both files together.
 *
 * Differences forced by the hardware or firmware:
 *   - The Lulu swaps Ctrl/GUI automatically on Windows/Linux. ZMK can't detect
 *     the OS, so here the swap is the WINDOWS layer, toggled with
 *     Settings + Win/Mac. That key also exists on the Lulu, so both boards match.
 *     ZMK doesn't remember the toggle after a restart or deep sleep.
 *   - Bluetooth and Studio keys work only here (KC_NO on the Lulu).
 *   - RGB keys work only on the Lulu (&none here: this board has no LEDs).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define WINDOWS 1
#define SYMBOLS 2
#define NUMBERS 3
#define NAV 4
#define SETTING 5

// Same hold-tap feel as the Lulu (QMK defaults + TAPPING_TERM 200 / QUICK_TAP_TERM 175).
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            // ┌───────┬───────┬───────┬───────┬───────┬───────┐                 ┌───────┬───────┬───────┬───────┬───────┬───────┐
            // │   `   │   1   │   2   │   3   │   4   │   5   │                 │   6   │   7   │   8   │   9   │   0   │   -   │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤                 ├───────┼───────┼───────┼───────┼───────┼───────┤
            // │  Tab  │   Q   │   W   │   E   │   R   │   T   │                 │   Y   │   U   │   I   │   O   │   P   │   \   │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤                 ├───────┼───────┼───────┼───────┼───────┼───────┤
            // │  Esc  │   A   │   S   │   D   │   F   │   G   ├───────┐ ┌───────┤   H   │   J   │   K   │   L   │   ;   │   '   │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤Reboot │ │SETTING├───────┼───────┼───────┼───────┼───────┼───────┤
            // │ Shift │   Z   │   X   │   C   │   V   │   B   ├───────┘ └───────┤   N   │   M   │   ,   │   .   │   /   │ Ctrl  │
            // └───────┴───────┼───────┼───────┼───────┼───────┤                 ├───────┼───────┼───────┼───────┼───────┴───────┘
            //                 │ Boot  │  GUI  │SH/Bspc│NAV/Del│                 │SYM/Ent│SH/Spc │NUM/Ent│ Ctrl  │
            //                 └───────┴───────┴───────┴───────┘                 └───────┴───────┴───────┴───────┘
            bindings = <
                &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                                 &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
                &kp ESC    &kp A   &kp S   &kp D   &kp F   &kp G                                 &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &sys_reset     &mo SETTING    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp LCTRL
                              &bootloader  &kp LGUI  &mt LSHFT BSPC  &lt NAV DEL     &lt SYMBOLS RET  &mt RSHFT SPACE  &lt NUMBERS RET  &kp LCTRL
            >;
        };

        windows_layer {
            display-name = "windows";
            // Ctrl/GUI swap, the same as the Lulu's automatic swap on Windows/Linux.
            // Everything else falls through to base.
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans           &trans  &trans  &trans  &trans  &trans  &kp LGUI
                                        &trans  &kp LCTRL  &trans  &trans          &trans  &trans  &trans  &kp LGUI
            >;
        };

        symbols_layer {
            display-name = "symbols";
            // Left hand: ( ) +  /  { } -  /  [ ] *      Right hand: = on H
            bindings = <
                &trans  &trans  &trans  &trans    &trans    &trans                               &trans     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &kp LPAR  &kp RPAR  &kp PLUS                             &trans     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &kp LBRC  &kp RBRC  &kp MINUS                            &kp EQUAL  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &kp LBKT  &kp RBKT  &kp ASTRK  &trans        &trans      &trans     &trans  &trans  &trans  &trans  &trans
                                        &trans    &trans    &trans     &trans        &trans      &trans     &trans  &trans
            >;
        };

        numbers_layer {
            display-name = "numbers";
            // Row 2: F1-F11, home row: 1-0
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans   &trans
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans           &trans  &trans  &trans  &trans  &trans   &trans
                                        &trans  &trans  &trans  &trans          &trans  &trans   &trans  &trans
            >;
        };

        nav_layer {
            display-name = "nav";
            // Right hand: mouse clicks/moves on the top row, arrows on home row, Home/PgDn/PgUp/End below
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                   &trans     &trans          &trans          &trans        &trans           &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                   &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp RCLK
                &trans  &trans  &trans  &trans  &trans  &trans                                   &kp LEFT   &kp DOWN        &kp UP          &kp RIGHT     &trans           &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans           &kp HOME   &kp PG_DN       &kp PG_UP       &kp END       &trans           &trans
                                        &trans  &trans  &trans  &trans          &trans  &trans   &trans     &trans
            >;
        };

        setting_layer {
            display-name = "settings";
            // ┌───────┬───────┬───────┬───────┬───────┬───────┐                 ┌───────┬───────┬───────┬───────┬───────┬───────┐
            // │       │  BT1  │  BT2  │       │       │       │                 │       │       │       │   -   │   -   │ (RGB) │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤                 ├───────┼───────┼───────┼───────┼───────┼───────┤
            // │Studio │BT clr │       │       │       │       │                 │       │       │       │(BRI-) │(BRI+) │       │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤                 ├───────┼───────┼───────┼───────┼───────┼───────┤
            // │Reboot │       │       │       │       │       ├───────┐ ┌───────┤       │       │       │(HUE-) │(HUE+) │Reboot │
            // ├───────┼───────┼───────┼───────┼───────┼───────┤Win/Mac│ │(held) ├───────┼───────┼───────┼───────┼───────┼───────┤
            // │ Boot  │       │       │       │       │       ├───────┘ └───────┤       │       │       │       │       │ Boot  │
            // └───────┴───────┴───────┴───────┴───────┴───────┘                 └───────┴───────┴───────┴───────┴───────┴───────┘
            // (…) = RGB keys that only do something on the Lulu.
            bindings = <
                &trans          &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &trans                         &trans  &trans  &trans  &none  &none  &none
                &studio_unlock  &bt BT_CLR    &trans        &trans  &trans  &trans                         &trans  &trans  &trans  &none  &none  &trans
                &sys_reset      &trans        &trans        &trans  &trans  &trans                         &trans  &trans  &trans  &none  &none  &sys_reset
                &bootloader     &trans        &trans        &trans  &trans  &trans  &tog WINDOWS  &trans   &trans  &trans  &trans  &trans &trans &bootloader
                                              &trans        &trans  &trans  &trans                &trans   &trans  &trans  &trans
            >;
        };
    };
};
